            "type": "INTEGER"
          },
          {
            "name": "unique_users",
            "id": "new_custo-unique_us-d91638",
            "type": "INTEGER"
          },
          {
            "name": "estimated_hours_saved",
            "id": "new_custo-estimated-dd218a",
            "type": "DECIMAL",
            "subType": "FLOAT"
          }
        ]
      }
    }
