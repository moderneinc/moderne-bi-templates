{
  "resourceType": "dataset",
  "dataSetId": "0cbcac07-577e-4fec-b1fc-a952a6374790",
  "name": "Build Tool Distribution",
  "physicalTableMap": {
    "98e244ec-7615-4d39-b06f-94fda8d3d853": {
      "customSql": {
        "dataSourceArn": "arn:aws:quicksight:<REGION>:<AWS_ACCOUNT_ID>:datasource/0727c710-7910-4a77-bfce-a0ad18953eea",
        "name": "Build Tool Distribution",
        "sqlQuery": "SELECT\n    CASE\n        WHEN buildmavenversion  <> '' THEN 'Maven'\n        WHEN buildgradleversion <> '' THEN 'Gradle'\n        WHEN buildbazelversion  <> '' THEN 'Bazel'\n        WHEN builddotnetversion <> '' THEN '.NET'\n        WHEN buildpythonversion <> '' THEN 'Python'\n        WHEN buildnodeversion   <> '' THEN 'Node.js'\n        ELSE 'Other'\n    END                      AS build_tool,\n    count(DISTINCT path)     AS repos,\n    count(DISTINCT buildid)  AS builds\nFROM moderne_telemetry.traces\nWHERE type IN ('build', 'run', 'apply', 'add', 'commit', 'publish')\n  AND buildoutcome = 'Succeeded'\nGROUP BY 1\nORDER BY repos DESC",
        "columns": [
          {
            "name": "build_tool",
            "id": "new_custo-build_too-38749e",
            "type": "STRING"
          },
          {
            "name": "repos",
            "id": "new_custo-repos-dc6499",
            "type": "INTEGER"
          },
          {
            "name": "builds",
            "id": "new_custo-builds-9fa81d",
            "type": "INTEGER"
          }
        ]
      }
    }
  },
