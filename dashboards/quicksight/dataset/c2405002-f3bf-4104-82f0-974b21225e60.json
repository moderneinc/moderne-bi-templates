{
  "resourceType": "dataset",
  "dataSetId": "c2405002-f3bf-4104-82f0-974b21225e60",
  "name": "Build Tool Versions",
  "physicalTableMap": {
    "c8f27047-9ff7-4d08-ae22-504729302c33": {
      "customSql": {
        "dataSourceArn": "arn:aws:quicksight:<REGION>:<AWS_ACCOUNT_ID>:datasource/0727c710-7910-4a77-bfce-a0ad18953eea",
        "name": "Build Tool Versions",
        "sqlQuery": "SELECT\n    CASE\n        WHEN buildmavenversion  <> '' THEN 'Maven'\n        WHEN buildgradleversion <> '' THEN 'Gradle'\n        WHEN buildbazelversion  <> '' THEN 'Bazel'\n        WHEN builddotnetversion <> '' THEN '.NET'\n        WHEN buildpythonversion <> '' THEN 'Python'\n        WHEN buildnodeversion   <> '' THEN 'Node.js'\n        ELSE 'Other'\n    END                      AS build_tool,\n    coalesce(\n        nullif(buildmavenversion,  ''),\n        nullif(buildgradleversion, ''),\n        nullif(buildbazelversion,  ''),\n        nullif(builddotnetversion, ''),\n        nullif(buildpythonversion, ''),\n        nullif(buildnodeversion,   ''),\n        'Unknown'\n    )                        AS tool_version,\n    count(DISTINCT path)     AS repos,\n    count(DISTINCT buildid)  AS builds\nFROM moderne_telemetry.traces\nWHERE type IN ('build', 'run', 'apply', 'add', 'commit', 'publish')\n  AND buildoutcome = 'Succeeded'\nGROUP BY 1, 2\nORDER BY build_tool, repos DESC",
        "columns": [
          {
            "name": "build_tool",
            "id": "new_custo-build_too-74d06b",
            "type": "STRING"
          },
          {
            "name": "tool_version",
            "id": "new_custo-tool_vers-0dd319",
            "type": "STRING"
          },
          {
            "name": "repos",
            "id": "new_custo-repos-b26145",
            "type": "INTEGER"
          },
          {
            "name": "builds",
            "id": "new_custo-builds-b977a7",
            "type": "INTEGER"
          }
        ]
      }
    }
