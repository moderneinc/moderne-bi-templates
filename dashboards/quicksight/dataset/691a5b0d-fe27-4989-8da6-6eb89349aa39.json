  "name": "Build Success Trend",
  "physicalTableMap": {
    "1b6d26a0-7dd2-409a-a7bc-d099028ebf95": {
      "customSql": {
        "dataSourceArn": "arn:aws:quicksight:<REGION>:<AWS_ACCOUNT_ID>:datasource/0727c710-7910-4a77-bfce-a0ad18953eea",
        "name": "Build Success Trend",
        "sqlQuery": "SELECT\n    date_trunc('month', buildstarttime)                                   AS month,\n    count(DISTINCT buildid)                                               AS total_builds,\n    count(DISTINCT CASE WHEN buildoutcome = 'Succeeded' THEN buildid END) AS successful_builds,\n    count(DISTINCT CASE WHEN buildoutcome <> 'Succeeded' THEN buildid END) AS failed_builds,\n    round(100.0 * count(DISTINCT CASE WHEN buildoutcome = 'Succeeded' THEN buildid END)\n        / count(DISTINCT buildid), 1)                                     AS success_rate_pct,\n    count(DISTINCT path)                                                  AS unique_repos\nFROM telemetry.traces\nWHERE type IN ('build', 'run', 'apply', 'add', 'commit', 'publish')\n  AND buildstarttime IS NOT NULL\nGROUP BY date_trunc('month', buildstarttime)\nORDER BY month",
        "columns": [
          {
            "name": "month",
            "id": "new_custo-month-bd6c69",
            "type": "DATETIME"
          },
          {
            "name": "total_builds",
