            "type": "INTEGER"
          },
          {
            "name": "unique_users",
            "id": "new_custo-unique_us-eb28df",
            "type": "INTEGER"
          },
          {
            "name": "unique_recipes",
            "id": "new_custo-unique_re-ecbe49",
            "type": "INTEGER"
          },
          {
            "name": "files_changed",
            "id": "new_custo-files_cha-c1f90d",
            "type": "INTEGER"
          },
          {
